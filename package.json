{
  "name": "@sitemachine/puck-static-assets",
  "version": "1.0.2",
  "description": "Static assets management plugin for Puck editor with upload, storage, and file management capabilities",
  "keywords": [
    "puck",
    "static-assets",
    "file-upload",
    "asset-management",
    "react",
    "chakra-ui"
  ],
  "author": "eyueldk",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "tsdown",
    "build:clean": "rm -rf dist && bun run build",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run format:check && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.6.2",
    "tsdown": "^0.16.6",
    "vite": "^7.2.4"
  },
  "peerDependencies": {
    "@measured/puck": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.29.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.90.10",
    "dexie": "^4.2.1",
    "mime-matcher": "^1.0.5",
    "next-themes": "^0.4.6",
    "react-icons": "^5.5.0",
    "usehooks-ts": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sitemachine/sitemachine-puck-static-assets.git"
  },
  "bugs": {
    "url": "https://github.com/sitemachine/sitemachine-puck-static-assets/issues"
  },
  "homepage": "https://github.com/sitemachine/sitemachine-puck-static-assets#readme"
}
